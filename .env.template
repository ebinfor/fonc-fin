# FONCIER+ v3.5.2 — Configuration
# ATTENTION : ne jamais committer ce fichier avec de vraies valeurs
#
# Génération des secrets :
#   JWT_SECRET     : openssl rand -hex 32
#   POSTGRES_PASSWORD : openssl rand -base64 24
#   REDIS_PASSWORD : openssl rand -base64 16
#   MINIO_SECRET   : openssl rand -base64 24

# Base de données
DATABASE_URL=postgresql+asyncpg://foncier:CHANGEME@localhost:5432/foncier_prod
POSTGRES_DB=foncier_prod
POSTGRES_USER=foncier
POSTGRES_PASSWORD=CHANGEME

# Redis
REDIS_URL=redis://:CHANGEME@localhost:6379/0
REDIS_PASSWORD=CHANGEME

# JWT — OBLIGATOIRE : générer avant démarrage
JWT_SECRET=CHANGEME_64_HEX_MINIMUM_32_CHARS

# MinIO / S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=foncier_minio
MINIO_SECRET_KEY=CHANGEME

# Sentry (optionnel)
SENTRY_DSN=

# Environnement
ENV=production
DEBUG=false
